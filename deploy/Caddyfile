# Proxies whose X-Forwarded-* headers are believed. Production faces the
# internet directly (nothing to trust); the staging copy sits behind
# production's Caddy and sets TRUSTED_PROXIES=private_ranges, so the API still
# sees https and the visitor's address.
{
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:127.0.0.1/32}
	}
}

# The app's addresses (DOMAIN may list several, comma-separated - e.g. the new
# one and an old one still in use): the web app, and the API under /api.
# Caddy gets and renews the HTTPS certificates by itself.
{$DOMAIN} {
	encode zstd gzip

	# Voice uploads (the API's own limit is 50 MB per request).
	request_body {
		max_size 60MB
	}

	handle /api/* {
		reverse_proxy api:8080
	}

	# The app's code and styles: a new name for every build, so they can be
	# cached for good - and a missing one is a 404, never the page (an old,
	# cached page asking for an old file would otherwise get HTML as JavaScript
	# and stay white after an update).
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The React app: unknown paths are its routes (/feed, /tasks/...). The page
	# (and icons, wallpapers) are always revalidated - cheap with ETags - so an
	# update reaches everyone at once.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# The brand's own addresses (e.g. "gatazee.com, www.gatazee.com"): the small
# site in deploy/site - home page, /privacy, /terms. Any other path (an old link
# to /feed...) goes on to the app. Unset: a local name that never asks for a
# certificate.
{$HOME_DOMAINS:www.localhost} {
	encode zstd gzip
	root * /site
	@page file {path} {path}.html {path}/index.html
	handle @page {
		try_files {path} {path}.html {path}/index.html
		header Cache-Control "no-cache"
		file_server
	}
	handle {
		redir https://{$HOME_REDIRECT:localhost}{uri} 302
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# Staging (deploy/compose.staging.yaml): its own stack on this server, forwarded
# to its web container on the shared "gatazee-edge" network. Unset: a local name
# that never asks for a certificate.
{$STAGING_DOMAIN:staging.localhost} {
	request_body {
		max_size 60MB
	}
	reverse_proxy staging-web:80
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}
