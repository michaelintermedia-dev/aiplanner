{
  "expo": {
    "name": "AI Planner",
    "slug": "ai-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aiplanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aiplanner.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aiplanner.app",
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withCameraAppQuery",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "AI Planner uses the microphone so you can capture tasks and appointments by voice."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickRecord",
              "label": "Quick recording",
              "description": "Tap to start recording right away",
              "minWidth": "57dp",
              "minHeight": "57dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "previewImage": "./assets/images/widget-quick-record.png",
              "resizeMode": "none",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AI Planner adds the photos you just took with the camera to your entry.",
          "savePhotosPermission": "AI Planner adds the photos you just took with the camera to your entry.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": ["photo"]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AI Planner lets you add photos from your library to your tasks, events and notes.",
          "cameraPermission": "AI Planner uses the camera so you can add photos to your tasks, events and notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
