{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "AllowedEmails": ""
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "AiPerTenMinutes": 30,
    "AiPerDay": 200
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ConnectionStrings": {
    "aiplannerdb": "Host=localhost;Port=5432;Database=aiplannerdb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_VIA_USER_SECRETS_OR_ENV_VAR",
    "Issuer": "AiPlannerApi",
    "Audience": "AiPlannerClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "AiProvider": {
    "Name": "OpenAI",
    "ApiKey": "REPLACE_VIA_USER_SECRETS_OR_ENV_VAR",
    "Model": "gpt-5.4-mini",
    "TranscriptionModel": "gpt-4o-mini-transcribe",
    "TimingModel": "whisper-1",
    "ReasoningEffort": "low"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalBasePath": "App_Data/voice-captures"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:19006" ]
  }
}
