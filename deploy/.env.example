# Copy to .env on the server and fill in. Never commit .env.

# The address the app is reached at (an A record pointing at the server's IP).
# Several, comma-separated, while moving to a new one: "app.example.com, old.example.com".
DOMAIN=planner.example.com
# Optional: the brand's own addresses, sent to the app (HOME_REDIRECT) until
# there's a landing page. Each needs an A record (or a CNAME) to the server too.
# HOME_DOMAINS=example.com, www.example.com
# HOME_REDIRECT=app.example.com

# Long random values - generate with: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=

# Your OpenAI key (sk-...).
OPENAI_API_KEY=

# Who may sign up (comma-separated). Leave empty only if anyone may.
ALLOWED_EMAILS=you@example.com

# AI calls (captures) per user per day.
AI_PER_DAY=200
