{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "aiplannerdb": "Server=localhost\\SQLEXPRESS;Database=AiPlannerDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_VIA_USER_SECRETS_OR_ENV_VAR",
    "Issuer": "AiPlannerApi",
    "Audience": "AiPlannerClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "AiProvider": {
    "Name": "OpenAI",
    "ApiKey": "REPLACE_VIA_USER_SECRETS_OR_ENV_VAR",
    "Model": "gpt-5.4-mini",
    "TranscriptionModel": "gpt-4o-mini-transcribe",
    "TimingModel": "whisper-1",
    "ReasoningEffort": "low"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalBasePath": "App_Data/voice-captures"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:19006" ]
  }
}
