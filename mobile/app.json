{
  "expo": {
    "name": "AI Planner",
    "slug": "ai-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aiplanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aiplanner.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aiplanner.app",
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "microphonePermission": "AI Planner uses the microphone so you can capture tasks and appointments by voice."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "AI Planner lets you add photos from your library to your tasks, events and notes.",
          "cameraPermission": "AI Planner uses the camera so you can add photos to your tasks, events and notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
