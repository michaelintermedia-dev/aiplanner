{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.EntityFrameworkCore.Update": "None",
      "Microsoft.EntityFrameworkCore.Database.Command": "None"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "AllowedEmails": ""
  },
  "Admin": {
    "Emails": ""
  },
  // US dollars per million tokens (or per audio minute). Keep in line with
  // https://openai.com/api/pricing - the AI cost report is only as right as these.
  "AiPricing": {
    "Models": {
      "gpt-5.4-mini": { "InputPerMillion": 0.25, "CachedInputPerMillion": 0.025, "OutputPerMillion": 2.0 },
      "gpt-4o-mini-transcribe": { "InputPerMillion": 1.25, "AudioInputPerMillion": 3.0, "OutputPerMillion": 5.0, "PerAudioMinute": 0.003 }
    }
  },
  "RateLimits": {
    "AuthPerMinute": 20,
    "AiPerTenMinutes": 30,
    "AiPerDay": 200
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "ConnectionStrings": {
    "aiplannerdb": "Host=localhost;Port=5432;Database=aiplannerdb;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_VIA_USER_SECRETS_OR_ENV_VAR",
    "Issuer": "AiPlannerApi",
    "Audience": "AiPlannerClients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "AiProvider": {
    "Name": "OpenAI",
    "ApiKey": "REPLACE_VIA_USER_SECRETS_OR_ENV_VAR",
    "Model": "gpt-5.4-mini",
    "TranscriptionModel": "gpt-4o-mini-transcribe",
    "ReasoningEffort": "low"
  },
  "FileStorage": {
    "Provider": "Local",
    "LocalBasePath": "App_Data/voice-captures"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:19006" ]
  }
}
