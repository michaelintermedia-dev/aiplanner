# Staging settings - copy to .env.staging on the server (next to compose.staging.yaml).
# Never commit it. Use NEW passwords/secrets here, not production's.

# Long random values - openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=

# OpenAI (the same key as production is fine; usage shows up under the same account).
OPENAI_API_KEY=

# Staging is private: only these may sign up (comma-separated).
ALLOWED_EMAILS=
ADMIN_EMAILS=

# Optional - leave empty and that feature is simply off on staging:
# email codes (Resend), web push (VAPID), Google sign-in (the Web client needs
# https://staging.gatazee.com added to its "Authorized JavaScript origins").
RESEND_API_KEY=
EMAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
GOOGLE_WEB_CLIENT_ID=
AI_PER_DAY=100
