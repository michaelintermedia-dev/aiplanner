{
  "expo": {
    "name": "Gatazee",
    "slug": "ai-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aiplanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.aiplanner.app",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4f5bd5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aiplanner.app",
      "permissions": [
        "android.permission.USE_EXACT_ALARM",
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withCameraAppQuery",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4f5bd5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gatazee uses your location only when you tap \"Use my location\", to fill in an item's place."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Gatazee uses the microphone so you can capture tasks and appointments by voice."
        }
      ],
      "expo-notifications",
      "expo-sharing",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "QuickRecord",
              "label": "Quick recording",
              "description": "Tap to start recording right away",
              "minWidth": "57dp",
              "minHeight": "57dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "previewImage": "./assets/images/widget-quick-record.png",
              "resizeMode": "none",
              "updatePeriodMillis": 0
            }
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Gatazee adds the photos you just took with the camera to your entry.",
          "savePhotosPermission": "Gatazee adds the photos you just took with the camera to your entry.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gatazee lets you add photos from your library to your tasks, events and notes.",
          "cameraPermission": "Gatazee uses the camera so you can add photos to your tasks, events and notes."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ],
          "androidMultiIntentFilters": [
            "image/*"
          ],
          "disableIOS": true
        }
      ],
      "./plugins/withPlayStoreManifest.js",
      "./plugins/withUploadSigning.js",
      "expo-background-task",
      [
        "expo-calendar",
        {
          "calendarPermission": "Gatazee shows your events and tasks in a calendar on this phone, if you turn it on in Settings."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
